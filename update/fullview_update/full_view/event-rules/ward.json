    {
      "id": "ward-move-1",
      "name": "住院登记后前往目标病房",
      "eventId": "WARD_ADMISSION_TO_BED",
      "classification": "住院移动",
      "trigger": "患者完成住院登记并已分配床位。",
      "rooms": [
        "R-WARD-WARD-ADMISSION",
        "R-WARD-RESP",
        "R-WARD-CARD",
        "R-WARD-GASTRO",
        "R-WARD-NEURO",
        "R-WARD-ENDO",
        "R-WARD-GENSURG",
        "R-WARD-ORTHO",
        "R-WARD-OBGYN",
        "R-WARD-PEDS"
      ],
      "roomsText": "ward_admission、resp_ward、card_ward、gastro_ward、neuro_ward、endo_ward、gensurg_ward、ortho_ward、obgyn_ward、peds_ward",
      "agents": "患者、医生/护士、BedManager 或叫号/转运系统。",
      "prechecks": "目标病房有空床；专科、年龄、性别、隔离等约束满足。",
      "actions": "移动患者从 ward_admission 到目标病房床位。",
      "successState": "患者状态变为 ADMITTED；目标床位占用。",
      "blocking": "无床或约束不匹配时患者留在 ward_admission。",
      "visualization": "患者进入 5F 病房并躺到空床。",
      "movement": {
        "schema": "patient-move",
        "from": "R-WARD-WARD-ADMISSION",
        "to": "target_ward_room",
        "via": [],
        "transport": "stretcher",
        "acuity": "routine",
        "patientFormDuringMove": "stretcher",
        "finalForm": "bed",
        "escortRequired": true,
        "escortRoles": [
          "porter",
          "ward_nurse"
        ],
        "equipment": [
          "transport_bag"
        ],
        "pathPolicy": {
          "requiresPath": true,
          "useElevator": false,
          "avoidWalls": true,
          "hallwayPreference": "center",
          "stopAtDoorBeforeEntering": true
        },
        "resourcePolicy": {
          "lockBeforeMove": true,
          "releaseSourceOnArrival": true,
          "occupyTargetOnArrival": true,
          "keepSourceReservedUntilArrival": false
        },
        "failurePolicy": {
          "onNoPath": "stay_source",
          "onResourceBlocked": "stay_source",
          "onEscortUnavailable": "continue_without_escort"
        },
        "patient_form_during_move": "stretcher",
        "final_form": "bed",
        "escort_required": true,
        "escort_roles": [
          "porter",
          "ward_nurse"
        ]
      },
      "sourceFile": "patient-movement-curated",
      "event_id": "WARD_ADMISSION_TO_BED"
    },
